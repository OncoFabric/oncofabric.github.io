---
interface Props {
  title: string;
  authors: string[];
  journal: string;
  year: number;
  category: string;
  doi?: string;
  url?: string;
  abstract?: string;
}

const { title, authors, journal, year, category, doi, url, abstract } = Astro.props;
const linkHref = url || (doi ? `https://doi.org/${doi}` : '');
---

<div class="paper-card" data-year={year} data-category={category}>
  <div class="paper-header">
    {linkHref ? (
      <a href={linkHref} target="_blank" rel="noopener noreferrer" class="paper-title">{title}</a>
    ) : (
      <span class="paper-title no-link">{title}</span>
    )}
    <span class="paper-category">{category}</span>
  </div>
  <p class="paper-authors">{authors.join(', ')}</p>
  <p class="paper-journal">
    <span class="journal-name">{journal}</span> &middot; {year}
    {doi && <> &middot; <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener noreferrer" class="doi-link">DOI</a></>}
  </p>
  {abstract && <p class="paper-abstract">{abstract}</p>}
</div>

<style>
  .paper-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
    transition: transform 0.15s ease, border-color 0.2s;
  }
  .paper-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }
  .paper-card[data-hidden="true"] {
    display: none;
  }
  .paper-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  .paper-title {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--teal);
    text-decoration: none;
    line-height: 1.3;
  }
  .paper-title:hover { text-decoration: underline; }
  .paper-title.no-link { color: var(--text-primary); }
  .paper-category {
    flex-shrink: 0;
    font-size: 11px;
    font-family: var(--mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--teal);
    background: var(--teal-glow);
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .paper-authors {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }
  .paper-journal {
    font-size: 12px;
    font-family: var(--mono);
    color: var(--text-tertiary);
  }
  .journal-name { font-style: italic; font-family: var(--sans); }
  .doi-link {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
  }
  .doi-link:hover { text-decoration: underline; }
  .paper-abstract {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
</style>
