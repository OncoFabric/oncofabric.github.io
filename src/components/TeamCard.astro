---
interface Props {
  name: string;
  title?: string;
  photo: string;
  photoPosition?: string;
  bio: string;
  links: {
    linkedin?: string;
    scholar?: string;
    website?: string;
  };
}

const { name, title, photo, photoPosition, bio, links } = Astro.props;
const hasLinks = links.linkedin || links.scholar || links.website;
---

<div class="team-card">
  <img src={photo} alt={name} class="team-photo" width="160" height="160" loading="lazy" style={photoPosition ? `object-position: ${photoPosition}` : undefined} />
  <h3 class="team-name">{name}</h3>
  {title && <p class="team-title">{title}</p>}
  <p class="team-bio">{bio}</p>
  {hasLinks && (
    <div class="team-links">
      {links.linkedin && (
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${name} on LinkedIn`}>
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      )}
      {links.scholar && (
        <a href={links.scholar} target="_blank" rel="noopener noreferrer" aria-label={`${name} on Google Scholar`}>
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 100 14 7 7 0 000-14z"/></svg>
        </a>
      )}
      {links.website && (
        <a href={links.website} target="_blank" rel="noopener noreferrer" aria-label={`${name}'s website`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
        </a>
      )}
    </div>
  )}
</div>

<style>
  .team-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 24px;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s;
  }
  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }
  .team-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 16px;
    border: 3px solid var(--bg-surface);
  }
  .team-name {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
    color: var(--text-primary);
  }
  .team-title {
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: 10px;
  }
  .team-bio {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }
  .team-links {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .team-links a {
    color: var(--teal);
    transition: opacity 0.15s;
  }
  .team-links a:hover {
    opacity: 0.7;
    text-decoration: none;
  }
</style>
