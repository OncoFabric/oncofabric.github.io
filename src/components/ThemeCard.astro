---
interface Props {
  number: string;
  title: string;
  description: string;
  id: string;
}

const { number, title, description, id } = Astro.props;

const icons: Record<string, string> = {
  'clinical-data-intelligence': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><circle cx="12" cy="15" r="3"/><path d="M12 12v3l1.5 1.5"/></svg>`,
  'multimodal-ai': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M10 6.5h4M6.5 10v4M17.5 10v4M10 17.5h4"/></svg>`,
  'trustworthy-ai': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>`,
  'evidence-grounded': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2Z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7Z"/></svg>`,
  'privacy-federated': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"/><circle cx="5" cy="19" r="3"/><circle cx="19" cy="19" r="3"/><path d="M10.5 7.5 7 16.5M13.5 7.5 17 16.5M7.5 19h9"/></svg>`,
};

const icon = icons[id] || '';
---

<div class="theme-card">
  <div class="theme-icon" set:html={icon} />
  <span class="theme-number">{number}</span>
  <h3 class="theme-title">{title}</h3>
  <p class="theme-description">{description}</p>
</div>

<style>
  .theme-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 22px;
    transition: border-color 0.2s, transform 0.15s ease;
  }
  .theme-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .theme-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    color: var(--teal);
  }
  .theme-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .theme-number {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--teal);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 6px;
  }
  .theme-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .theme-description {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>
