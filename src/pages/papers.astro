---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import PaperCard from '../components/PaperCard.astro';
import papers from '../data/papers.json';

const sortedPapers = [...papers].sort((a, b) => b.year - a.year);
const years = [...new Set(sortedPapers.map(p => p.year))].sort((a, b) => b - a);
const categories = [...new Set(sortedPapers.map(p => p.category))].sort();
---

<BaseLayout title="Papers — OncoFabric" description="Peer-reviewed research from the OncoFabric team.">
  <div class="page-content">

    <section class="papers-header" data-animate>
      <SectionLabel text="Research" variant="teal" />
      <h1 class="page-headline">Peer-Reviewed Papers</h1>
      <p class="page-subtitle">Peer-reviewed research from our lab in multimodal AI, foundation models, and clinical intelligence.</p>
    </section>

    <!-- Filters -->
    <div class="filters" data-animate id="filters">
      <div class="filter-group">
        <span class="filter-label">Year</span>
        <button class="filter-chip active" data-filter="year" data-value="all">All</button>
        {years.map(year => (
          <button class="filter-chip" data-filter="year" data-value={String(year)}>{year}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">Category</span>
        <button class="filter-chip active" data-filter="category" data-value="all">All</button>
        {categories.map(cat => (
          <button class="filter-chip" data-filter="category" data-value={cat}>{cat}</button>
        ))}
      </div>
    </div>

    <!-- Papers List -->
    <div class="papers-list" data-animate id="papers-list">
      {sortedPapers.map(paper => (
        <PaperCard
          title={paper.title}
          authors={paper.authors}
          journal={paper.journal}
          year={paper.year}
          category={paper.category}
          doi={paper.doi}
          url={paper.url}
          abstract={paper.abstract}
        />
      ))}
    </div>

    <p class="no-results" id="no-results">No papers match the selected filters.</p>

  </div>
</BaseLayout>

<style>
  .papers-header {
    margin-bottom: 28px;
  }
  .page-headline {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .page-subtitle {
    font-size: var(--text-base);
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filter-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    min-width: 64px;
  }
  .filter-chip {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-chip:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .filter-chip.active {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
  }
  .papers-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .no-results {
    display: none;
    text-align: center;
    font-size: 14px;
    color: var(--text-tertiary);
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .page-headline { font-size: 28px; }
    .filter-label { min-width: auto; width: 100%; }
  }
</style>

<script>
  const filters: Record<string, string> = { year: 'all', category: 'all' };
  const chips = document.querySelectorAll('.filter-chip');
  const cards = document.querySelectorAll('.paper-card');
  const noResults = document.getElementById('no-results');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filterType = chip.getAttribute('data-filter')!;
      const value = chip.getAttribute('data-value')!;
      filters[filterType] = value;

      // Update active chips in this group
      chips.forEach(c => {
        if (c.getAttribute('data-filter') === filterType) {
          c.classList.toggle('active', c.getAttribute('data-value') === value);
        }
      });

      // Filter cards
      let visible = 0;
      cards.forEach(card => {
        const yearMatch = filters.year === 'all' || card.getAttribute('data-year') === filters.year;
        const catMatch = filters.category === 'all' || card.getAttribute('data-category') === filters.category;
        const hidden = !(yearMatch && catMatch);
        card.setAttribute('data-hidden', String(hidden));
        if (!hidden) visible++;
      });

      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
    });
  });
</script>
