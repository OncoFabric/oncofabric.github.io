---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import PublicationCard from '../components/PublicationCard.astro';
import publications from '../data/publications.json';

const sortedPublications = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(sortedPublications.map(p => p.year))].sort((a, b) => b - a);
const categories = [...new Set(sortedPublications.map(p => p.category))].sort();
---

<BaseLayout title="Publications — OncoFabric" description="Research publications from the OncoFabric team.">
  <div class="page-content">

    <section class="publications-header" data-animate>
      <SectionLabel text="Research" variant="teal" />
      <h1 class="page-headline">Publications</h1>
      <p class="page-subtitle">Research from our lab in multimodal AI, foundation models, clinical intelligence, and more.</p>
    </section>

    <!-- Filters -->
    <div class="filters" data-animate id="filters">
      <div class="filter-group">
        <span class="filter-label">Year</span>
        <button class="filter-chip active" data-filter="year" data-value="all">All</button>
        {years.map(year => (
          <button class="filter-chip" data-filter="year" data-value={String(year)}>{year}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">Category</span>
        <button class="filter-chip active" data-filter="category" data-value="all">All</button>
        {categories.map(cat => (
          <button class="filter-chip" data-filter="category" data-value={cat}>{cat}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">Status</span>
        <button class="filter-chip active" data-filter="status" data-value="all">All</button>
        <button class="filter-chip" data-filter="status" data-value="published">Published</button>
        <button class="filter-chip" data-filter="status" data-value="preprint">Preprint</button>
      </div>
    </div>

    <!-- Publications List -->
    <div class="publications-list" data-animate id="publications-list">
      {sortedPublications.map(pub => (
        <PublicationCard
          title={pub.title}
          authors={pub.authors}
          journal={pub.journal}
          year={pub.year}
          category={pub.category}
          doi={pub.doi}
          url={pub.url}
          abstract={pub.abstract}
          preprint={pub.preprint}
        />
      ))}
    </div>

    <p class="no-results" id="no-results">No publications match the selected filters.</p>

  </div>
</BaseLayout>

<style>
  .publications-header {
    margin-bottom: 28px;
  }
  .page-headline {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .page-subtitle {
    font-size: var(--text-base);
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filter-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    min-width: 64px;
  }
  .filter-chip {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-chip:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .filter-chip.active {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
  }
  .publications-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .no-results {
    display: none;
    text-align: center;
    font-size: 14px;
    color: var(--text-tertiary);
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .page-headline { font-size: 28px; }
    .filter-label { min-width: auto; width: 100%; }
  }
</style>

<script>
  const filters: Record<string, string> = { year: 'all', category: 'all', status: 'all' };
  const chips = document.querySelectorAll('.filter-chip');
  const cards = document.querySelectorAll('.publication-card');
  const noResults = document.getElementById('no-results');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filterType = chip.getAttribute('data-filter')!;
      const value = chip.getAttribute('data-value')!;
      filters[filterType] = value;

      // Update active chips in this group
      chips.forEach(c => {
        if (c.getAttribute('data-filter') === filterType) {
          c.classList.toggle('active', c.getAttribute('data-value') === value);
        }
      });

      // Filter cards
      let visible = 0;
      cards.forEach(card => {
        const yearMatch = filters.year === 'all' || card.getAttribute('data-year') === filters.year;
        const catMatch = filters.category === 'all' || card.getAttribute('data-category') === filters.category;
        const isPreprint = card.getAttribute('data-preprint') === 'true';
        const statusMatch = filters.status === 'all' ||
          (filters.status === 'preprint' && isPreprint) ||
          (filters.status === 'published' && !isPreprint);
        const hidden = !(yearMatch && catMatch && statusMatch);
        card.setAttribute('data-hidden', String(hidden));
        if (!hidden) visible++;
      });

      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
    });
  });
</script>
